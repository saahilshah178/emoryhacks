# Fill these in privately. Never paste them into chat.

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# FaceTime voice (Chert / LiveKit realtime). Not used by the web app grader.
OPENAI_API_KEY=

# Gemini grades each recording against the home steps in skills/.
# Leave empty to use GEMINI_API_KEY from the repo .env.
GEMINI_API_KEY=

# The name chert dev dispatches. Must match ServerOptions.agentName.
AGENT_NAME=caregiver-coach

# Not used for grading any more: the home steps are not the web app's steps.
# Leave the two logins empty.
WEB_APP_URL=http://localhost:3000
WEB_APP_USERNAME=
WEB_APP_PASSWORD=

# Optional. Besides a muted or removed video track, the caller's camera counts
# as off after this many milliseconds with no picture (default 2500). Raise it
# if a poor connection ends recordings while the camera is on.
CAMERA_OFF_MS=

CHERT_PROJECT_ID=2e897612-3ffd-4f01-bdf8-27f60d3c8981
CHERT_LINE_ID=9f048001-c57b-494c-b28c-358bcaa23fa3
CHERT_LINE_NUMBER=+16282787200
