# Copy to .env and fill in. .env is gitignored.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tiger Data service connection string (Tiger Cloud console -> your service -> Connect)
# postgres://tsdbadmin:PASSWORD@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
# If this is empty or not a postgres:// URL the app falls back to DEV_DATABASE_URL,
# which defaults to the local TimescaleDB container started by `make db`.
DATABASE_URL=

# Optional overrides
# GEMINI_MODEL_MAIN=gemini-4-hydrogen
# GEMINI_MODEL_STRONG=gemini-4-carbon
# GEMINI_BUDGET_USD=14         # hard stop on recorded Gemini spend for this database
# FIRSTSHIFT_FAKE_AI=1         # canned stage outputs, no Gemini calls
# POSE_FPS=10

# Passwords for the six fixed logins are not set here. `make logins` makes them and writes
# them to LOGINS.md (gitignored); `make logins ARGS="--reset <name>"` replaces one.
# `make reset-data` shows what it would delete to start from scratch (ARGS="--yes" does it).
# FIRSTSHIFT_DATA_DIR=         # where videos and thumbnails are kept (default: data/)
